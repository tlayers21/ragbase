{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ruff: format and fix",
      "type": "shell",
      "command": "source .venv/bin/activate && ruff format . && ruff check . --fix",
      "group": "build",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "TypeScript: type check",
      "type": "shell",
      "command": "cd frontend && npx tsc --noEmit",
      "group": "build",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "RAGbase: start",
      "type": "shell",
      "command": "bash scripts/start.sh",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "RAGbase: reset",
      "type": "shell",
      "command": "bash scripts/reset_all.sh",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    }
  ]
}
